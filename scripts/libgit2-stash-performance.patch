+		if (delta->status == GIT_DELTA_ADDED ||
+			delta->status == GIT_DELTA_MODIFIED ||
+			delta->status == GIT_DELTA_TYPECHANGE) {
+			updates[count].action = GIT_TREE_UPDATE_UPSERT;
+			updates[count].path = delta->new_file.path;
+			updates[count].filemode = delta->new_file.mode;
+			git_oid_cpy(&updates[count].id, &delta->new_file.id);
+			count++;
