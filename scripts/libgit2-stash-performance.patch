+static int stash_remove_index_path(git_index *index, const char *path)
+{
+	int error;
+
+	error = git_index_remove_bypath(index, path);
+	if (error == GIT_ENOTFOUND) {
+		git_error_clear();
+		error = 0;
+	}
+	if (error < 0)
+		return error;
+	error = git_index_remove_directory(index, path, 0);
+	if (error == GIT_ENOTFOUND) {
+		git_error_clear();
+		error = 0;
+	}
+	return error;
+}
