+static int stash_update_index_path(
+	git_index *target,
+	git_index *source,
+	const char *path)
+{
+	const git_index_entry *entry;
+	int error;
+
+	error = git_index_remove_bypath(target, path);
+	if (error == GIT_ENOTFOUND) {
+		git_error_clear();
+		error = 0;
+	}
+	if (error < 0)
+		return error;
+
+	error = git_index_remove_directory(target, path, 0);
+	if (error == GIT_ENOTFOUND) {
+		git_error_clear();
+		error = 0;
+	}
+	if (error < 0)
+		return error;
+
+	entry = git_index_get_bypath(source, path, 0);
+	return entry ? git_index_add(target, entry) : 0;
+}
