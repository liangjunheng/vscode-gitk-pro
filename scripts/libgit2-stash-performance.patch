+static bool stash_default_path_needs_checkout(
+	git_repository *repo,
+	const char *path)
+{
+	git_str full_path = GIT_STR_INIT;
+	char buffer[8192];
+	ssize_t len;
+	int fd = -1;
+	size_t i;
+	bool needs_checkout = false;
