+	if (git_str_joinpath(&full_path, git_repository_workdir(repo), path) < 0 ||
+		(fd = git_futils_open_ro(git_str_cstr(&full_path))) < 0)
+		goto cleanup;
+	while ((len = p_read(fd, buffer, sizeof(buffer))) > 0) {
+		for (i = 0; i < (size_t)len; i++) {
+			if (buffer[i] == '\0' || buffer[i] == '\r')
+				goto cleanup;
+			if (buffer[i] == '\n')
+				needs_checkout = true;
+		}
+	}
+
+cleanup:
+	if (fd >= 0)
+		p_close(fd);
+	git_str_dispose(&full_path);
+	return needs_checkout;
+}
