{
  "name": "vscode-gitk-pro",
  "displayName": "vscode-gitk-pro",
  "description": "A gitk-style commit graph panel for VS Code",
  "version": "1.0.1",
  "publisher": "liangjunheng",
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "*"
  ],
  "icon": "media/gitk-logo.png",
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vscode-gitk.open",
        "title": "Open Gitk Panel",
        "category": "Gitk"
      },
      {
        "command": "vscode-gitk.refresh",
        "title": "Refresh Gitk",
        "category": "Gitk"
      },
      {
        "command": "vscode-gitk.selectCommit",
        "title": "Select Commit",
        "category": "Gitk",
        "enablement": "false"
      }
    ],
    "viewsContainers": {
      "panel": [
        {
          "id": "vscode-gitk",
          "title": "Gitk",
          "icon": "media/gitk-icon.svg"
        }
      ]
    },
    "views": {
      "vscode-gitk": [
        {
          "type": "webview",
          "id": "vscode-gitk.panelView",
          "name": "Gitk",
          "icon": "media/gitk-icon.svg",
          "contextualTitle": "Gitk",
          "when": "gitk:hasRepository"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "vscode-gitk.refresh",
          "when": "view == vscode-gitk.panelView",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "node scripts/copy-monaco.cjs && tsc -p ./",
    "watch": "node scripts/copy-monaco.cjs && tsc -watch -p ./",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.1.0"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.36",
    "monaco-editor": "^0.52.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/liangjunheng/vscode-gitk-pro.git"
  },
  "homepage": "https://github.com/liangjunheng/vscode-gitk-pro"
}
