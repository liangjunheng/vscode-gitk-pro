{
  "name": "vscode-gitk-pro",
  "displayName": "Gitk Pro",
  "description": "Explore Git history, multi-file diffs, branches, and working-tree changes in a Gitk-style panel",
  "version": "1.0.7",
  "publisher": "liangjunheng",
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "*"
  ],
  "icon": "media/gitk-logo.png",
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Gitk",
      "properties": {
        "vscode-gitk.changedFilesDisplayMode": {
          "type": "string",
          "enum": [
            "tree",
            "flat"
          ],
          "enumDescriptions": [
            "按目录树显示变更文件",
            "以平铺列表显示变更文件"
          ],
          "default": "flat",
          "scope": "window",
          "description": "Changed Files 的显示方式"
        }
      }
    },
    "commands": [
      {
        "command": "vscode-gitk.open",
        "title": "Open Gitk Panel",
        "category": "Gitk"
      },
      {
        "command": "vscode-gitk.refresh",
        "title": "Refresh Gitk",
        "category": "Gitk"
      },
      {
        "command": "vscode-gitk.selectCommit",
        "title": "Select Commit",
        "category": "Gitk",
        "enablement": "false"
      },
      {
        "command": "vscode-gitk.multiDiff.previousChange",
        "title": "上一个差异",
        "category": "Gitk",
        "icon": "$(arrow-up)"
      },
      {
        "command": "vscode-gitk.multiDiff.nextChange",
        "title": "下一个差异",
        "category": "Gitk",
        "icon": "$(arrow-down)"
      },
      {
        "command": "vscode-gitk.commitEditMsg.complete",
        "title": "Commit",
        "category": "Gitk",
        "icon": "$(check)"
      },
      {
        "command": "vscode-gitk.commitEditMsg.cancel",
        "title": "Close",
        "category": "Gitk",
        "icon": "$(close)"
      }
    ],
    "viewsContainers": {
      "panel": [
        {
          "id": "vscode-gitk",
          "title": "Gitk",
          "icon": "media/gitk-icon.svg"
        }
      ]
    },
    "views": {
      "vscode-gitk": [
        {
          "type": "webview",
          "id": "vscode-gitk.panelView",
          "name": "Gitk",
          "icon": "media/gitk-icon.svg",
          "contextualTitle": "Gitk"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "vscode-gitk.refresh",
          "when": "view == vscode-gitk.panelView",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "vscode-gitk.multiDiff.previousChange",
          "when": "activeWebviewPanelId == vscode-gitk.multiDiff",
          "group": "navigation@10"
        },
        {
          "command": "vscode-gitk.multiDiff.nextChange",
          "when": "activeWebviewPanelId == vscode-gitk.multiDiff",
          "group": "navigation@11"
        },
        {
          "command": "vscode-gitk.commitEditMsg.complete",
          "when": "editorLangId == git-commit && resourceFilename == COMMIT_EDITMSG && gitk:commitEditMsgActive",
          "group": "navigation@1"
        },
        {
          "command": "vscode-gitk.commitEditMsg.cancel",
          "when": "editorLangId == git-commit && resourceFilename == COMMIT_EDITMSG && gitk:commitEditMsgActive",
          "group": "navigation@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "vscode-gitk.commitEditMsg.complete",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "gitk:commitEditMsgActive"
      },
      {
        "command": "vscode-gitk.commitEditMsg.cancel",
        "key": "escape",
        "when": "gitk:commitEditMsgActive"
      },
      {
        "command": "vscode-gitk.multiDiff.nextChange",
        "key": "f7",
        "when": "activeWebviewPanelId == vscode-gitk.multiDiff"
      },
      {
        "command": "vscode-gitk.multiDiff.previousChange",
        "key": "f8",
        "when": "activeWebviewPanelId == vscode-gitk.multiDiff"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "node scripts/copy-monaco.cjs && tsc -p ./",
    "watch": "node scripts/copy-monaco.cjs && tsc -watch -p ./",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.1.0"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.36",
    "monaco-editor": "^0.52.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/liangjunheng/vscode-gitk-pro.git"
  },
  "homepage": "https://github.com/liangjunheng/vscode-gitk-pro"
}
