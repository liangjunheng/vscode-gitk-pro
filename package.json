{
  "name": "fastergit",
  "displayName": "FasterGit",
  "description": "Git history graph, multi-file diffs, branch management, multi-repository commits, and merge conflict resolution for VS Code, backed by a built-in libgit2 module.",
  "version": "1.5.9",
  "publisher": "liangjunheng",
  "license": "MIT",
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "*"
  ],
  "enabledApiProposals": [
    "contribEditorContentMenu"
  ],
  "icon": "media/fastergit-logo.png",
  "main": "./out/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "contributes": {
    "languages": [
      {
        "id": "COMMIT_MSG_EDITOR",
        "aliases": [
          "Commit Message Editor"
        ],
        "configuration": "./syntaxes/commit-msg-editor.language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "COMMIT_MSG_EDITOR",
        "scopeName": "text.commit-msg-editor",
        "path": "./syntaxes/commit-msg-editor.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "FasterGit",
      "properties": {
        "vscode-gitk.changedFilesDisplayMode": {
          "type": "string",
          "enum": [
            "tree",
            "flat"
          ],
          "enumDescriptions": [
            "按目录树显示 Changed Files 与 Commit Editor 文件",
            "以平铺列表显示 Changed Files 与 Commit Editor 文件"
          ],
          "default": "flat",
          "scope": "application",
          "description": "Changed Files 与 Commit Editor 的同步显示方式"
        },
        "vscode-gitk.showStashes": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "description": "在 Commit 列表中显示 Stash。列表右上角的 Stash 按钮会同步更新此设置。"
        },
        "vscode-gitk.multiDiffRenderSideBySide": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "FasterGit Diff 面板是否使用双栏模式显示差异"
        },
        "vscode-gitk.discardUntrackedChangesToTrash": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "还原未跟踪文件时移入回收站，而不是永久删除。回收站不可用的环境 (远程、Snap) 将始终永久删除。"
        },
        "vscode-gitk.useSystemProxy": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "远程 Git 操作使用 VS Code 或系统配置的 HTTP/HTTPS 代理。"
        }
      }
    },
    "commands": [
      {
        "command": "vscode-gitk.open",
        "title": "Open Panel",
        "category": "FasterGit"
      },
      {
        "command": "vscode-gitk.openCommitPanel",
        "title": "Open Commit Panel",
        "category": "FasterGit",
        "icon": "$(git-commit)"
      },
      {
        "command": "vscode-gitk.selectCommit",
        "title": "Select Commit",
        "category": "FasterGit",
        "enablement": "false"
      },
      {
        "command": "vscode-gitk.multiDiff.previousChange",
        "title": "上一个差异",
        "category": "FasterGit",
        "icon": "$(arrow-up)",
        "enablement": "activeWebviewPanelId == vscode-gitk.multiDiff && gitk:multiDiffCanNavigatePrevious"
      },
      {
        "command": "vscode-gitk.multiDiff.nextChange",
        "title": "下一个差异",
        "category": "FasterGit",
        "icon": "$(arrow-down)",
        "enablement": "activeWebviewPanelId == vscode-gitk.multiDiff && gitk:multiDiffCanNavigateNext"
      },
      {
        "command": "vscode-gitk.multiDiff.search",
        "title": "搜索整个 MultiDiff",
        "category": "FasterGit",
        "icon": "$(search)",
        "enablement": "activeWebviewPanelId == vscode-gitk.multiDiff"
      },
      {
        "command": "vscode-gitk.multiDiff.useInlineView",
        "title": "当前：双栏模式（切换到单栏）",
        "category": "FasterGit",
        "icon": "$(layout-centered)"
      },
      {
        "command": "vscode-gitk.multiDiff.useSideBySideView",
        "title": "当前：单栏模式（切换到双栏）",
        "category": "FasterGit",
        "icon": "$(layout-centered)"
      },
      {
        "command": "vscode-gitk.commitEditMsg.history",
        "title": "历史提交信息",
        "category": "FasterGit",
        "icon": "$(history)"
      },
      {
        "command": "vscode-gitk.commitEditMsg.complete",
        "title": "Commit",
        "category": "FasterGit",
        "icon": "$(check)"
      },
      {
        "command": "vscode-gitk.commitEditMsg.cancel",
        "title": "Close",
        "category": "FasterGit",
        "icon": "$(close)"
      }
    ],
    "viewsContainers": {
      "panel": [
        {
          "id": "vscode-gitk",
          "title": "FasterGit",
          "icon": "media/fastergit-sidebar.png"
        }
      ]
    },
    "views": {
      "vscode-gitk": [
        {
          "type": "webview",
          "id": "vscode-gitk.panelView",
          "name": "FasterGit",
          "icon": "media/fastergit-sidebar.png",
          "contextualTitle": "FasterGit"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "vscode-gitk.openCommitPanel",
          "when": "view == vscode-gitk.panelView",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "vscode-gitk.multiDiff.search",
          "when": "activeWebviewPanelId == vscode-gitk.multiDiff",
          "group": "navigation@9"
        },
        {
          "command": "vscode-gitk.multiDiff.previousChange",
          "when": "activeWebviewPanelId == vscode-gitk.multiDiff",
          "group": "navigation@10"
        },
        {
          "command": "vscode-gitk.multiDiff.nextChange",
          "when": "activeWebviewPanelId == vscode-gitk.multiDiff",
          "group": "navigation@11"
        },
        {
          "command": "vscode-gitk.multiDiff.useInlineView",
          "when": "activeWebviewPanelId == vscode-gitk.multiDiff && gitk:multiDiffRenderSideBySide",
          "group": "navigation@12"
        },
        {
          "command": "vscode-gitk.multiDiff.useSideBySideView",
          "when": "activeWebviewPanelId == vscode-gitk.multiDiff && !gitk:multiDiffRenderSideBySide",
          "group": "navigation@12"
        },
        {
          "command": "vscode-gitk.commitEditMsg.history",
          "when": "gitk:commitEditMsgActive",
          "group": "navigation@0"
        },
        {
          "command": "vscode-gitk.commitEditMsg.complete",
          "when": "gitk:commitEditMsgActive",
          "group": "navigation@1"
        },
        {
          "command": "vscode-gitk.commitEditMsg.cancel",
          "when": "gitk:commitEditMsgActive",
          "group": "navigation@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "vscode-gitk.commitEditMsg.complete",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "gitk:commitEditMsgActive"
      },
      {
        "command": "vscode-gitk.commitEditMsg.cancel",
        "key": "escape",
        "when": "gitk:commitEditMsgActive"
      },
      {
        "command": "vscode-gitk.multiDiff.search",
        "key": "ctrl+f",
        "mac": "cmd+f",
        "when": "activeWebviewPanelId == vscode-gitk.multiDiff"
      },
      {
        "command": "vscode-gitk.multiDiff.nextChange",
        "key": "f7",
        "when": "activeWebviewPanelId == vscode-gitk.multiDiff"
      },
      {
        "command": "vscode-gitk.multiDiff.previousChange",
        "key": "shift+f7",
        "when": "activeWebviewPanelId == vscode-gitk.multiDiff"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "node scripts/copy-monaco.cjs && tsc -p ./",
    "watch": "node scripts/copy-monaco.cjs && tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "build:native": "node scripts/build-native.cjs",
    "build": "npm run compile",
    "test:native": "cargo test --manifest-path native/git2-backend/Cargo.toml",
    "test:binding": "node scripts/test-native-binding.cjs",
    "test:git-cli-remote": "node scripts/test-git-cli-remote-operations.cjs",
    "test:system-proxy": "node scripts/test-system-proxy.cjs",
    "test:merge-editor": "node scripts/test-merge-editor.cjs && node scripts/test-aggregate-merge.cjs",
    "test:parity": "npm run check:native && npm run test:native && npm run build:native && npm run compile && npm run test:binding",
    "check:native": "cargo fmt --check --manifest-path native/git2-backend/Cargo.toml && cargo clippy --manifest-path native/git2-backend/Cargo.toml --all-targets --all-features -- -D warnings",
    "package:vsix": "vsce package",
    "build:native:all": "node scripts/build-native-all.cjs",
    "verify:native:all": "node scripts/verify-native-platform.cjs universal",
    "build:native:all:local": "powershell -NoProfile -ExecutionPolicy Bypass -File ./build-native-all.ps1"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.10.4",
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.94.0",
    "@vscode/vsce": "^3.9.2",
    "playwright": "^1.64.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.1.0"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.45",
    "monaco-editor": "^0.52.2",
    "node-diff3": "^3.2.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/liangjunheng/vscode-gitk-pro.git"
  },
  "homepage": "https://github.com/liangjunheng/vscode-gitk-pro"
}
