.vscode/**
.vscode-test/**
.codebuddy/**
.github/**
src/**
native/**
scripts/**
node_modules/**

# Keep compiled extension JavaScript, but omit source maps and declarations.
out/**/*.js.map
out/**/*.d.ts

# Project/build metadata not required at runtime.
*.vsix
.gitignore
.vscodeignore
tsconfig.json
README.md

# Include media resources used by the extension UI.
!media/**

# Package only final native bindings; omit build caches and N-API transaction files.
target/**
cargo-target/**
.xwin/**
.native-tools/**
lib/*
lib/*/**
!lib/*/*.node
**/*.tmp
**/*.swp
**/.napi-rs-filesystem-transaction.swp/**
**/*.d.ts
